def print_plan(items: List[Item], log: Log, dirty: bool) -> None:
    if not items:
        log.info("No paired Bluetooth devices found in Windows.")
        return
    adapters = sorted({i.entry.adapter for i in items})
    for ad in adapters:
        log.info("\nAdapter %s" % ad)
        for it in [i for i in items if i.entry.adapter == ad]:
            e = it.entry
            extra = ""
            if it.status in (ADDR_CHANGED,) or (it.linux and it.linux.mac != e.mac):
                extra = "  [Linux: %s]" % it.linux.mac
            log.info("  %-6s %s  %-28s %s%s" % (
                "LE" if e.kind == "le" else "BR/EDR", e.mac, e.label()[:28],
                STATUS_TEXT[it.status], extra))
    if dirty:
        log.warn("the Windows registry was not cleanly saved (Fast Startup / hibernation or a crash). "
                 "Very recent pairings may be missing. Fix: in Windows, disable Fast Startup "
                 "(`windows\\bt-dualboot-sync.ps1 -DisableFastStartup`) and use Restart, not Shut down.")


def confirm(question: str, assume_yes: bool) -> bool:
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        raise UserError("refusing to modify files without --yes in a non-interactive session")
    return input(question + " [y/N] ").strip().lower() in ("y", "yes")


def restart_bluetooth(log: Log) -> None:
    r = run(["systemctl", "restart", "bluetooth"])
    if r.returncode == 0:
        log.info("Restarted bluetooth.service - your devices should reconnect in a few seconds.")
    else:
        log.warn("could not restart bluetooth.service (%s). Run: sudo systemctl restart bluetooth"
                 % (r.stderr.strip() or r.returncode))


def apply_items(items: List[Item], args, state: Dict[str, str], log: Log) -> int:
    """Copy Windows keys into BlueZ. Returns the number of changed devices."""
    if not items:
        return 0
    backup_bluez(args.bluez_dir, args.backup_dir, log)
    changed = 0
    for it in items:
        e, ld = it.entry, it.linux
        if it.status == ADDR_CHANGED:
            new_dir = os.path.join(os.path.dirname(ld.path), e.mac)
            if os.path.exists(new_dir):
                log.warn("%s already exists, skipping %s" % (new_dir, e.label()))
                continue
            shutil.copytree(ld.path, new_dir, symlinks=True)
            cache_dir = os.path.join(os.path.dirname(ld.path), "cache")
            old_cache, new_cache = os.path.join(cache_dir, ld.mac), os.path.join(cache_dir, e.mac)
            if os.path.isfile(old_cache) and not os.path.exists(new_cache):
                shutil.copy2(old_cache, new_cache)
            shutil.rmtree(ld.path)  # a copy is in the backup
            ld = LinuxDevice(ld.adapter, e.mac, new_dir, ld.info)
            log.info("  moved %s -> %s (%s)" % (it.linux.mac, e.mac, e.label()))
        apply_windows_entry(ld.info, e, not args.irk_no_reverse)
        write_info(ld.info, ld.info_path)
        state[e.state_key] = digest(e.material())
        log.info("  updated %s %s (%s)" % ("LE" if e.kind == "le" else "BR/EDR", e.mac, e.label()))
        changed += 1
    return changed


def load_everything(args, log: Log, src: WindowsSource):
    hive_path = src.locate()
    log.debug("Windows registry hive: %s" % hive_path)
    try:
        hive = Hive.open(hive_path)
        win = read_windows_keys(hive)
    except (HiveError, struct.error) as ex:
        raise UserError("could not read the Windows registry (%s): %s" % (hive_path, ex))
    linux = read_bluez(args.bluez_dir)
    state = load_state(args.state_file)
    items = build_plan(win, linux, state)
    for it in items:  # remember what is already identical
        if it.status == IN_SYNC:
            state[it.entry.state_key] = digest(it.entry.material())
    return hive, items, state


def cmd_status(args, log: Log) -> int:
    with WindowsSource(args.windows, log) as src:
        hive, items, _ = load_everything(args, log, src)
    print_plan(items, log, hive.dirty)
    return 0


def cmd_sync(args, log: Log) -> int:
    """Windows -> Linux."""
    with WindowsSource(args.windows, log) as src:
        hive, items, state = load_everything(args, log, src)
    print_plan(items, log, hive.dirty)
    wanted = {WIN_NEWER, DIFFERENT, ADDR_CHANGED} | ({LINUX_NEWER} if args.force else set())
    todo = [i for i in items if i.status in wanted]
    skipped = [i for i in items if i.status == LINUX_NEWER and not args.force]
    if skipped:
        log.info("\n%d device(s) were re-paired in Linux after the last sync; they were left alone "
                 "(use `export`, or --force to overwrite them with the Windows keys)." % len(skipped))
    if not todo:
        log.info("\nNothing to copy from Windows.")
        if not args.dry_run:
            save_state(args.state_file, state)
        return 0
    if args.dry_run:
        log.info("\n--dry-run: would update %d device(s)." % len(todo))
        return 0
    if not confirm("\nCopy %d Windows key(s) into Linux?" % len(todo), args.yes):
        return 1
    changed = apply_items(todo, args, state, log)
    save_state(args.state_file, state)
    if changed and not args.no_restart:
        restart_bluetooth(log)
    return 0


def cmd_export(args, log: Log) -> int:
    """Linux -> file for Windows."""
    with WindowsSource(args.windows, log) as src:
        hive, items, state = load_everything(args, log, src)
    print_plan(items, log, hive.dirty)
    wanted = {LINUX_NEWER, DIFFERENT} | ({WIN_NEWER} if args.force else set())
    todo = [i for i in items if i.status in wanted and i.linux and i.linux.mac == i.entry.mac]
    path = args.export_path or default_export_path()
    if not path:
        raise UserError("EFI system partition not found at %s; pass --export-path"
                        % ", ".join(ESP_CANDIDATES))
    if not todo:
        log.info("\nNo Linux keys newer than Windows - nothing to export.")
        return 0
    if args.dry_run:
        log.info("\n--dry-run: would export %d device(s) to %s" % (len(todo), path))
        return 0
    write_export(path, [export_record(i, not args.irk_no_reverse) for i in todo], log)
    save_state(args.state_file, state)
    return 0


def cmd_auto(args, log: Log) -> int:
    """Boot-time mode: copy newer Windows keys, export newer Linux keys."""
    with WindowsSource(args.windows, log) as src:
        hive, items, state = load_everything(args, log, src)
    print_plan(items, log, hive.dirty)
    to_linux = [i for i in items if i.status in (WIN_NEWER, DIFFERENT, ADDR_CHANGED)]
    to_win = [i for i in items if i.status == LINUX_NEWER and i.linux and i.linux.mac == i.entry.mac]
    if args.dry_run:
        log.info("\n--dry-run: %d to Linux, %d to Windows" % (len(to_linux), len(to_win)))
        return 0
    changed = apply_items(to_linux, args, state, log)
    save_state(args.state_file, state)
    path = args.export_path or default_export_path()
    if path:
        if to_win and not hive.dirty:
            write_export(path, [export_record(i, not args.irk_no_reverse) for i in to_win], log)
        elif os.path.exists(path) and not to_win:
            os.remove(path)  # nothing pending - don't let Windows import stale keys
    elif to_win:
        log.warn("EFI partition not found; cannot export %d Linux key(s) for Windows" % len(to_win))
    if changed and not args.no_restart:
        restart_bluetooth(log)
    return 0


def cmd_install(args, log: Log) -> int:
    src = os.path.realpath(__file__)
    if src != INSTALL_BIN:
        shutil.copy2(src, INSTALL_BIN)
    os.chmod(INSTALL_BIN, 0o755)
    with open(UNIT_PATH, "w", encoding="utf-8") as f:
        f.write(UNIT_TEMPLATE.format(bin=INSTALL_BIN))
    for cmd in (["systemctl", "daemon-reload"], ["systemctl", "enable", "bt-dualboot-sync.service"]):
        r = run(cmd)
        if r.returncode != 0:
            raise UserError("%s failed: %s" % (" ".join(cmd), r.stderr.strip()))
    log.info("Installed %s and enabled bt-dualboot-sync.service." % INSTALL_BIN)
    log.info("From now on, every Linux boot copies newer Windows keys before Bluetooth starts.")
    return 0


def cmd_uninstall(args, log: Log) -> int:
    run(["systemctl", "disable", "bt-dualboot-sync.service"])
    for p in (UNIT_PATH, INSTALL_BIN):
        if os.path.exists(p):
            os.remove(p)
    run(["systemctl", "daemon-reload"])
    log.info("Removed bt-dualboot-sync service. (State and backups are kept in %s and %s.)"
             % (os.path.dirname(DEFAULT_STATE_FILE), DEFAULT_BACKUP_DIR))
    return 0


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--windows", metavar="PATH",
                        help="Windows SYSTEM hive file, Windows mount point, or /dev/partition "
                             "(default: auto-detect)")
    common.add_argument("--bluez-dir", default=DEFAULT_BLUEZ_DIR, help=argparse.SUPPRESS)
    common.add_argument("--state-file", default=DEFAULT_STATE_FILE, help=argparse.SUPPRESS)
    common.add_argument("--backup-dir", default=DEFAULT_BACKUP_DIR, help=argparse.SUPPRESS)
    common.add_argument("--export-path", metavar="FILE",
                        help="where to write keys for Windows (default: <EFI partition>/%s/%s)"
                             % (EXPORT_SUBDIR, EXPORT_FILENAME))
    common.add_argument("-n", "--dry-run", action="store_true", help="show what would change, change nothing")
    common.add_argument("-y", "--yes", action="store_true", help="do not ask for confirmation")
    common.add_argument("-f", "--force", action="store_true",
                        help="ignore sync history (sync: Windows always wins; export: Linux always wins)")
    common.add_argument("--no-restart", action="store_true", help="do not restart bluetooth.service")
    common.add_argument("--irk-no-reverse", action="store_true",
                        help="do not byte-swap the LE Identity Resolving Key (try this if an LE "
                             "device with a private address does not reconnect)")
    common.add_argument("-v", "--verbose", action="store_true")
    common.add_argument("-q", "--quiet", action="store_true")

    p = argparse.ArgumentParser(
        prog=PROG,
        description="Share Bluetooth pairings between Windows and Linux on dual-boot PCs.",
        epilog="Typical use: pair the device in Linux, reboot to Windows and pair it there, "
               "reboot to Linux and run `sudo %s sync`. Run `sudo %s install` to do this "
               "automatically at every boot." % (PROG, PROG))
    p.add_argument("--version", action="version", version="%s %s" % (PROG, VERSION))
    sub = p.add_subparsers(dest="command", metavar="COMMAND")
    sub.add_parser("status", parents=[common], help="list devices and whether their keys match")
    sub.add_parser("sync", parents=[common], help="copy Windows keys into Linux (Windows -> Linux)")
    sub.add_parser("export", parents=[common],
                   help="export Linux keys for the Windows importer (Linux -> Windows)")
    sub.add_parser("auto", parents=[common],
                   help="both directions, decided by sync history (used by the boot service)")
    sub.add_parser("install", parents=[common], help="install the boot-time systemd service")
    sub.add_parser("uninstall", parents=[common], help="remove the boot-time systemd service")
    return p


COMMANDS = {"status": cmd_status, "sync": cmd_sync, "export": cmd_export, "auto": cmd_auto,
            "install": cmd_install, "uninstall": cmd_uninstall}


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    log = Log(args.verbose, args.quiet)
    needs_root = args.command in ("install", "uninstall") or args.bluez_dir == DEFAULT_BLUEZ_DIR
    if needs_root and hasattr(os, "geteuid") and os.geteuid() != 0:
        print("%s: please run with sudo (Bluetooth keys are only readable by root)" % PROG,
              file=sys.stderr)
        return 1
    try:
        return COMMANDS[args.command](args, log)
    except UserError as e:
        print("error: %s" % e, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
